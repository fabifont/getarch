{
  "version": 1,
  "disk": {"path": "/dev/sda", "wipe_before": false},
  "partitioning": {"layout": "efi-swap-root", "efi_size_mib": 1024, "swap_size_mib": 4096},
  "filesystem": {"kind": "btrfs", "label": "system"},
  "encryption": {"kind": "luks2", "password": "CHANGE_ME", "mapper_name": "system"},
  "swap": {"kind": "partition", "size_mib": 4096},
  "kernel": {"kind": "linux-lts"},
  "microcode": {"kind": "intel"},
  "bootloader": {"kind": "systemd-boot", "entry_id": "arch", "timeout_seconds": 3, "extra_kernel_params": ["quiet"]},
  "initramfs": {
    "generator": "mkinitcpio",
    "hooks": ["base", "systemd", "autodetect", "modconf", "kms", "keyboard", "sd-vconsole", "block", "sd-encrypt", "filesystems", "fsck"]
  },
  "locale": {
    "lang": "en_US.UTF-8",
    "locale": "en_US.UTF-8 UTF-8",
    "keymap": "us",
    "timezone": "Europe/Rome"
  },
  "network": {"hostname": "workstation", "backend": "networkmanager"},
  "packages": ["base", "base-devel", "linux-lts", "linux-firmware", "networkmanager", "sudo", "vim", "git", "openssh"],
  "services": {"enable": ["NetworkManager", "sshd"], "timers": ["fstrim.timer"]},
  "mirrors": {"strategy": "reflector", "reflector_args": ["--country", "Italy", "--latest", "10", "--sort", "rate"]},
  "users": {
    "root": {"kind": "prompt"},
    "regular": [
      {"username": "alice", "password": "CHANGE_ME", "groups": ["wheel", "video", "audio"], "sudo": true},
      {"username": "bob", "groups": ["users"], "sudo": false}
    ]
  },
  "reboot": false
}
