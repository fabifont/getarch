# Copy to .env and fill in. .env is gitignored.

# Required: the repository (or org) URL the runner registers against.
REPO_URL=https://github.com/fabifont/getarch

# Required: short-lived registration token. Get one from
#   Settings -> Actions -> Runners -> "New self-hosted runner".
# Tokens expire after one hour but are only needed at registration time.
RUNNER_TOKEN=

# Optional: friendly runner name shown in the GitHub Actions UI.
# Defaults to getarch-kvm-<hostname>.
RUNNER_NAME=

# Optional: runner labels. MUST include "kvm" to match the qemu-smoke
# workflow's `runs-on: [self-hosted, kvm]` selector.
RUNNER_LABELS=self-hosted,Linux,X64,kvm

# Optional: pin the GitHub Actions runner version. Bump when a new
# release lands at https://github.com/actions/runner/releases.
RUNNER_VERSION=2.319.1
