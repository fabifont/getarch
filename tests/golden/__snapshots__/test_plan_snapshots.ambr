      {
        "id": "partitioning",
        "title": "Partition disk",
        "phase": "partitioning",
        "destructive": true,
        "description": "Create GPT layout 'efi-root' on /dev/sda",
        "commands": [
          {
            "argv": [
              "sgdisk",
              "--zap-all",
              "/dev/sda"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "wipe partition table"
          },
          {
            "argv": [
              "sgdisk",
              "--new=1:0:+512MiB",
              "/dev/sda"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "create partition 1 (EFI, ef00)"
          },
          {
            "argv": [
              "sgdisk",
              "--typecode=1:ef00",
              "/dev/sda"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "set partition 1 type to ef00"
          },
          {
            "argv": [
              "sgdisk",
              "--change-name=1:EFI",
