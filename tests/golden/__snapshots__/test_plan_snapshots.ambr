            "sensitive": false,
            "input": null,
            "description": "create /boot mountpoint"
          },
          {
            "argv": [
              "mount",
              "/dev/disk/by-partlabel/EFI",
              "/mnt/boot"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "mount EFI at /boot"
          },
          {
            "argv": [
              "mkdir",
              "-p",
              "/mnt/home"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "create /home mountpoint"
          },
          {
            "argv": [
              "mount",
              "/dev/disk/by-partlabel/home",
              "/mnt/home"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "mount /home filesystem"
          }
        ]
      },
      {
        "id": "swap",
        "title": "Create swapfile",
        "phase": "swap",
        "destructive": false,
        "description": "create 2048 MiB swapfile",
        "commands": [
          {
            "argv": [
              "mkdir",
              "-p",
              "/mnt/swap"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "create /mnt/swap"
          },
          {
            "argv": [
              "chattr",
              "+C",
              "/mnt/swap"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "disable CoW on /mnt/swap for btrfs swap"
          },
          {
            "argv": [
              "fallocate",
              "-l",
              "2048MiB",
              "/mnt/swap/swapfile"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "allocate 2048 MiB swapfile"
          },
          {
            "argv": [
              "chmod",
              "600",
              "/mnt/swap/swapfile"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "restrict swapfile permissions"
          },
          {
            "argv": [
              "mkswap",
              "/mnt/swap/swapfile"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "format swapfile"
          },
          {
            "argv": [
              "swapon",
              "/mnt/swap/swapfile"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "activate swapfile so genfstab records it"
          }
        ]
      },
      {
        "id": "packages",
        "title": "Pacstrap base packages",
        "phase": "packages",
        "destructive": false,
        "description": "install base packages into the new system",
        "commands": [
          {
            "argv": [
              "pacstrap",
              "-K",
              "/mnt",
              "base",
              "base-devel",
              "linux",
              "linux-firmware",
              "networkmanager",
              "sudo",
              "vim",
              "intel-ucode"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "install 8 packages into /mnt"
          }
        ]
      },
      {
        "id": "fstab",
        "title": "Generate fstab",
        "phase": "fstab",
        "destructive": false,
        "description": "write /mnt/etc/fstab",
        "commands": [
          {
            "argv": [
              "sh",
              "-c",
              "genfstab -L -p /mnt >> /mnt/etc/fstab"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "genfstab -L -p (label-based)"
          }
        ]
      },
      {
        "id": "system_config",
        "title": "System configuration",
        "phase": "system-config",
        "destructive": false,
        "description": "locale, timezone, hostname, hosts, vconsole",
        "commands": [
          {
            "argv": [
              "install",
              "-Dm644",
              "/dev/stdin",
              "/mnt/etc/locale.conf"
            ],
            "chroot": false,
            "sensitive": false,
            "input": "LANG=en_US.UTF-8\n",
            "description": "write /etc/locale.conf"
          },
          {
            "argv": [
              "install",
              "-Dm644",
              "/dev/stdin",
              "/mnt/etc/locale.gen"
            ],
            "chroot": false,
            "sensitive": false,
            "input": "en_US.UTF-8 UTF-8\n",
            "description": "write /etc/locale.gen"
          },
          {
            "argv": [
              "locale-gen"
            ],
            "chroot": true,
            "sensitive": false,
            "input": null,
            "description": "run locale-gen"
          },
          {
            "argv": [
              "install",
              "-Dm644",
              "/dev/stdin",
              "/mnt/etc/vconsole.conf"
            ],
            "chroot": false,
            "sensitive": false,
            "input": "KEYMAP=us\n",
            "description": "write /etc/vconsole.conf"
          },
          {
            "argv": [
              "ln",
              "-sf",
              "/usr/share/zoneinfo/UTC",
              "/etc/localtime"
            ],
            "chroot": true,
            "sensitive": false,
            "input": null,
            "description": "set timezone to UTC"
          },
          {
            "argv": [
              "hwclock",
              "--systohc"
            ],
            "chroot": true,
            "sensitive": false,
            "input": null,
            "description": "sync hardware clock"
          },
          {
            "argv": [
              "install",
              "-Dm644",
              "/dev/stdin",
              "/mnt/etc/hostname"
            ],
            "chroot": false,
            "sensitive": false,
            "input": "arch\n",
            "description": "write /etc/hostname"
          },
          {
            "argv": [
              "install",
              "-Dm644",
              "/dev/stdin",
              "/mnt/etc/hosts"
            ],
            "chroot": false,
            "sensitive": false,
            "input": "127.0.0.1 localhost\n::1       localhost\n127.0.1.1 arch.localdomain arch\n",
            "description": "write /etc/hosts"
          }
        ]
      },
      {
        "id": "initramfs",
        "title": "Generate initramfs",
        "phase": "initramfs",
        "destructive": false,
        "description": "write hooks snippet and run mkinitcpio",
        "commands": [
          {
            "argv": [
              "install",
              "-Dm644",
              "/dev/stdin",
              "/mnt/etc/mkinitcpio.conf.d/10-hooks.conf"
            ],
            "chroot": false,
            "sensitive": false,
            "input": "HOOKS=(base udev autodetect modconf block filesystems fsck)\n",
            "description": "write mkinitcpio hooks snippet at /mnt/etc/mkinitcpio.conf.d/10-hooks.conf"
          },
          {
            "argv": [
              "mkinitcpio",
              "-p",
              "linux"
            ],
            "chroot": true,
            "sensitive": false,
            "input": null,
            "description": "regenerate initramfs for linux"
          }
        ]
      },
      {
        "id": "bootloader",
        "title": "Install bootloader",
        "phase": "bootloader",
        "destructive": false,
        "description": "install systemd-boot and write loader entry",
        "commands": [
          {
            "argv": [
              "bootctl",
              "--esp-path=/mnt/boot",
              "install"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "install systemd-boot to ESP (run outside chroot for EFI vars)"
          },
          {
            "argv": [
              "install",
              "-Dm644",
              "/dev/stdin",
              "/mnt/boot/loader/loader.conf"
            ],
            "chroot": false,
            "sensitive": false,
            "input": "default arch.conf\ntimeout 5\nconsole-mode auto\neditor no\n",
            "description": "write /mnt/boot/loader/loader.conf"
          },
          {
            "argv": [
              "install",
              "-Dm644",
              "/dev/stdin",
              "/mnt/boot/loader/entries/arch.conf"
            ],
            "chroot": false,
            "sensitive": false,
            "input": "title Arch Linux\nlinux /vmlinuz-linux\ninitrd /intel-ucode.img\ninitrd /initramfs-linux.img\noptions root=LABEL=system rootflags=subvol=@ rw\n",
            "description": "write /mnt/boot/loader/entries/arch.conf"
          }
        ]
      },
      {
        "id": "services",
        "title": "Enable services and timers",
        "phase": "services",
        "destructive": false,
        "description": "systemctl enable for declared units",
        "commands": [
          {
            "argv": [
              "systemctl",
              "enable",
              "NetworkManager"
            ],
            "chroot": true,
            "sensitive": false,
            "input": null,
            "description": "enable NetworkManager"
          },
          {
            "argv": [
              "systemctl",
              "enable",
              "fstrim.timer"
            ],
            "chroot": true,
            "sensitive": false,
            "input": null,
            "description": "enable fstrim.timer"
          }
        ]
      },
      {
        "id": "users",
        "title": "Configure users",
        "phase": "users",
        "destructive": false,
        "description": "set root password and create regular users",
        "commands": []
      },
      {
        "id": "cleanup",
        "title": "Unmount target",
        "phase": "cleanup",
        "destructive": false,
        "description": "umount -R /mnt",
        "commands": [
          {
            "argv": [
              "swapoff",
              "/mnt/swap/swapfile"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "deactivate swapfile so target filesystem is not busy"
          },
          {
            "argv": [
              "umount",
              "-R",
              "/mnt"
            ],
            "chroot": false,
            "sensitive": false,
            "input": null,
            "description": "recursively unmount target"
          }
        ]
      }
    ]
  }
